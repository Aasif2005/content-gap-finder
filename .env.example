# --- Required API keys -------------------------------------------------
# https://console.cloud.google.com/apis/credentials  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key

# --- Server ------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- DeepSeek models ---------------------------------------------------
# deepseek-v4-pro  = reasoning model, used for clustering + gap mining
# deepseek-flash   = fast/cheap, used for lighter passes
DEEPSEEK_MODEL_ANALYSIS=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-flash

# --- Quota guardrails --------------------------------------------------
# YouTube Data API default project quota is 10,000 units/day.
# search.list costs 100 units; videos/channels/commentThreads cost 1 each.
YOUTUBE_DAILY_UNIT_BUDGET=9000
# Max videos we pull comment threads for (1 unit each, but also latency)
MAX_COMMENT_VIDEOS=25
# Cache TTL for a niche+window result, in seconds (default 3h)
CACHE_TTL_SECONDS=10800
# Per-IP analyses allowed per hour
RATE_LIMIT_PER_HOUR=10
