# --- Required API keys -------------------------------------------------
# https://console.cloud.google.com/apis/credentials  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key

# --- Database (MongoDB Atlas) ------------------------------------------
# Atlas > Connect > Drivers. Keep the real value only in .env, never commit it.
# URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gapstronaut

# --- Server ------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- DeepSeek models ---------------------------------------------------
# deepseek-flash  = default. ~10-20s per pass, and in testing it matched
#                   deepseek-v4-pro's output quality on both clustering and
#                   gap mining while being ~3.5x faster.
# deepseek-v4-pro = reasoning model. Noticeably slower (40-65s per pass, and it
#                   can exceed 180s on messy real-world payloads). Set
#                   DEEPSEEK_MODEL_ANALYSIS to it if you want deeper analysis
#                   and can tolerate the latency.
DEEPSEEK_MODEL_ANALYSIS=deepseek-flash
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_TIMEOUT_MS=120000

# --- Quota guardrails --------------------------------------------------
# Since 2026-06-01 YouTube meters search.list in its own bucket (100 calls/day by
# default, 1 unit each). Everything else (videos, channels, commentThreads,
# playlistItems: 1 unit each) shares the 10,000-unit bucket. Keep both a little
# under Google's limits; raise them after a quota extension is approved.
YOUTUBE_SEARCH_DAILY_CALLS=95
YOUTUBE_DAILY_UNIT_BUDGET=9000
# Max videos we pull comment threads for (1 unit each, but also latency)
MAX_COMMENT_VIDEOS=25
# Comments requested per video. commentThreads.list caps at 100 per call.
COMMENTS_PER_VIDEO=50
# Cache TTL for a niche+window result, in seconds (default 6h)
CACHE_TTL_SECONDS=21600
# How long each YouTube response a run fetched is kept, so a stopped or repeated run does not pay for it twice (default 6h)
YOUTUBE_SOURCE_CACHE_SECONDS=21600
# Per-IP analyses allowed per hour
RATE_LIMIT_PER_HOUR=10
# Per-IP "Make it" briefs per hour (one DeepSeek call each, no YouTube quota)
BRIEF_RATE_LIMIT_PER_HOUR=30
# Number of proxies in front of the server (e.g. 1 behind nginx). Leave 0 when the
# server is reached directly, or X-Forwarded-For can be forged to dodge the rate limit.
TRUST_PROXY=0
# The public address, like https://yourdomain.com. Used for the sitemap, canonical links,
# social previews and the https redirect. Empty = the host each request came in on.
SITE_URL=
# Extra origins allowed to call the API from a browser, comma-separated. Empty = same
# origin only, which covers the built app and the Vite dev proxy.
CORS_ORIGINS=
# Per-request timeout for YouTube API calls, in ms.
YOUTUBE_TIMEOUT_MS=30000
# "Make it" has no target length: a brief runs as long as what viewers asked for takes to
# teach. This is only the ceiling past which a request is too broad for one video.
BRIEF_MAX_MINUTES=15
# A gap with at most this many comments AND at most this many likes is an "early signal":
# the brief suggests testing it as a Short before filming the long version.
BRIEF_THIN_COMMENTS=3
BRIEF_THIN_LIKES=5
# Leave unset: DeepSeek's thinking mode (the default) gave steadier, better-grounded briefs than
# thinking disabled in a measured comparison. "disabled" makes BRIEF_TEMPERATURE take effect.
# BRIEF_THINKING=disabled
# BRIEF_TEMPERATURE=0.2

# --- Evidence thresholds -----------------------------------------------
# How much each OUTPUT needs before it is called "solid" (see the README). Heat is a
# rank within the set: one video moves a score by 100/(n-1) points, 14 at 8 videos.
# Judgement defaults with a stated reason, not statistical laws -- tune freely.
# THIN_POOL_THRESHOLD is the old name for EVIDENCE_HEAT_MIN_VIDEOS.
EVIDENCE_HEAT_MIN_VIDEOS=8
EVIDENCE_HEAT_FLOOR=5
EVIDENCE_HEAT_MIN_CHANNELS=4
EVIDENCE_GAP_MIN_VIDEOS=5
EVIDENCE_GAP_MIN_COMMENTS=100
EVIDENCE_OUTLIER_MIN_CHANNELS=5
# Share of what was found that filters must remove before they are blamed for a short list
EVIDENCE_FILTER_BLAME_SHARE=0.3

# --- Channel-median outliers -------------------------------------------
# Top N channels whose recent uploads are read as a baseline so each video can
# be scored as a multiple of its OWN channel's median (~2 units per channel).
# 0 turns it off. A median needs MIN_BASELINE same-format uploads, and uploads
# younger than MIN_AGE_DAYS are ignored (views still accumulating).
OUTLIER_CHANNELS=20
OUTLIER_MIN_BASELINE=4
OUTLIER_MIN_AGE_DAYS=3
OUTLIER_THRESHOLD=2

# --- Accounts (Firebase) -----------------------------------------------
# Sign-in is Firebase Authentication (Google + email/password). The server only
# VERIFIES ID tokens, which needs the project id and no secret. Leave it unset to
# run without accounts: everyone is logged out and analyses, briefs and watches
# answer 503 AUTH_NOT_CONFIGURED.
FIREBASE_PROJECT_ID=
# The web app's Firebase config. It is public by design (it ships in the browser
# bundle; access is controlled by Firebase rules and authorized domains, not by
# hiding it). Vite reads these from this root .env at build/dev time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Per-account allowances, counted per Pacific day (they reset with the YouTube
# quota). A cached report or joining a run already in flight is always free.
USER_DAILY_ANALYSES=3
USER_DAILY_BRIEFS=20
USER_MAX_WATCHES=2
# Comma-separated emails that may read the operator API (GET /api/logs, /api/quota).
# Empty means nobody. Run logs cover every account's searches and quote comments.
ADMIN_EMAILS=
# The sample report on the marketing homepage: this exact run if FEATURED_RUN_ID is
# set and still on disk, else the newest run of FEATURED_NICHE with 2+ gaps, else a
# labelled example. Runs older than YOUTUBE_DATA_MAX_DAYS are never shown, so a pinned
# run needs replacing within that time.
FEATURED_NICHE=sourdough starter
FEATURED_RUN_ID=
# The reports in the homepage app (up to 4). `npm run featured` analyses FEATURED_NICHES and
# prints this line after showing every public quote. YouTube data expires after 30 days, so
# repeat it about every 25 days; expired ids drop out and labelled examples take their place.
FEATURED_NICHES=AI side hustles,smartphone reviews,beginner investing,mechanical keyboards
FEATURED_RUN_IDS=

# --- Publishing (YouTube API compliance) -------------------------------
# Shown on /privacy and /terms. The audit expects a contact method there.
CONTACT_EMAIL=
# Reports, briefs, cache and run logs hold YouTube API data, which the Developer
# Policies allow for 30 days. Can be lowered, never raised past 30.
YOUTUBE_DATA_MAX_DAYS=30

# --- Persisted reports -------------------------------------------------
# Finished reports are kept by run id so /r/<runId> stays openable after the
# cache expires. Pruned by count (newest kept) and by age (YOUTUBE_DATA_MAX_DAYS).
# The per-niche gap history recurrence compares against holds only our own
# questions and scores, so it is kept for 36 months instead.
STORE_MAX_RUNS=500

# --- Gap recurrence ----------------------------------------------------
# The model re-words every gap each run, so matching a gap to its own history
# has to be fuzzy. Stemmed-token Jaccard overlap, plus a floor on shared tokens
# because one coincidental word ("shorts", "beginner") can clear a ratio
# threshold on its own when both questions are short.
RECURRENCE_MIN_SIMILARITY=0.4
RECURRENCE_MIN_SHARED_TOKENS=2
# Runs closer together than this re-read the same comments: they count as one
# sighting, and a run this recent is not compared against at all.
RECURRENCE_MIN_HOURS=24

# --- Saved-watch scheduler ---------------------------------------------
# Single-instance, like the in-process job registry: two servers sharing a
# database would fire every watch twice. Set false on replicas.
SCHEDULER_ENABLED=true
# The "Custom" published-date range is off until the YouTube quota extension is
# approved. Also flip CUSTOM_RANGE in web/src/components/SearchForm.jsx.
ALLOW_CUSTOM_WINDOW=false
# Deep scan and watches spend extra search.list calls (of 100 a day), so they
# stay off until the quota audit. Also flip DEEP_SCAN / WATCHES in web/src/lib/features.js.
ALLOW_DEEP_SCAN=false
ALLOW_WATCHES=false
SCHEDULER_CHECK_INTERVAL_MS=300000
# Floor on how often a watch may re-run. Each run spends real quota with nobody
# watching, so a 1-hour interval would drain the day's budget unattended.
SCHEDULER_MIN_INTERVAL_HOURS=6
SCHEDULER_MAX_WATCHES=20

# Testing: accounts listed here get TESTER_DAILY_ANALYSES / TESTER_DAILY_BRIEFS instead of the standard allowance
TESTER_EMAILS=
TESTER_DAILY_ANALYSES=100
TESTER_DAILY_BRIEFS=100
