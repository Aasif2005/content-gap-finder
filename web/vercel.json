{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api-production-16c8.up.railway.app/api/:path*" },
    { "source": "/", "destination": "/seo/home.html" },
    { "source": "/login", "destination": "/seo/login.html" },
    { "source": "/signup", "destination": "/seo/signup.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/auth/action", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/seo/privacy.html" },
    { "source": "/terms", "destination": "/seo/terms.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/channel", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/r/:id([a-zA-Z0-9_-]+)", "destination": "/index.html" },
    { "source": "/channel/r/:id([a-zA-Z0-9_-]+)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.firebaseapp.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=15552000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
