  "narrative": {
    "northStar": "The Research Desk at Night",
    "overview": "A desk lamp over evidence. The page shows its working: every claim sits beside the viewer quote and the video behind it. The homepage lives on a night-navy ground; the logged-in app follows the OS between cool paper and the same night values. Panels are quiet, rows are separated by hairlines rather than boxed into card grids, and the only loud thing is the amber highlighter, which marks words a real viewer wrote.",
    "keyCharacteristics": [
      "Two grounds from one token set: paper (light) and night (dark), switchable per section.",
      "One signature: the amber highlighter, reserved for real viewer evidence.",
      "Semantic tokens only in new work.",
      "Flat panels with a 1px hairline and a barely-there shadow.",
      "Self-hosted variable type: Schibsted Grotesk, Geist Mono for figures."
    ],
    "rules": [
      {
        "name": "The Single Highlighter Rule",
        "body": "Amber is used for exactly one meaning: a run of text a real viewer wrote. Never for buttons, badges, warnings, charts, or decoration. Warnings are burnt orange.",
        "section": "colors"
      },
      {
        "name": "The Two Grounds Rule",
        "body": "Theme comes from the OS; .theme-night and .theme-day pin any section. Components use semantic tokens so they work on both with no per-theme code.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Any number shown in a column or meter uses .nums so values do not jitter.",
        "section": "typography"
      },
      {
        "name": "The Flat Rest Rule",
        "body": "Resting surfaces never gain a heavier shadow; only menus and dialogs float, and they use soft, blurred, negative-spread shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic tokens so a section works in both grounds.",
      "Do put amber behind viewer-written text only, via EvidenceMark.",
      "Do place the Derived info glyph after every figure Gapstronaut calculated.",
      "Do keep controls at 44px minimum and use drawn icons from one library (lucide).",
      "Do separate content with hairline rows and flat panels.",
      "Do keep figures in Geist Mono with tabular numerals."
    ],
    "donts": [
      "Don't use gradients, glass or backdrop blur, or neon and thumbnail-yellow creator-tool styling.",
      "Don't add kickers or eyebrow labels above headings.",
      "Don't nest cards inside cards.",
      "Don't use hard offset shadows; soft ones only, and only on floating layers.",
      "Don't use emoji; use drawn icons.",
      "Don't mark callouts with a coloured left border; use a tinted Alert.",
      "Don't use amber for status, buttons or charts; warnings are burnt orange.",
      "Don't add new colours outside the semantic tokens."
    ]
  }
